{
    "name": "hera-frontend",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "dev": "vite",
        "staging": "vite -m staging",
        "prod": "vite -m prod",
        "build": "run-p type-check build-only",
        "build-staging": "run-p type-check build-only-staging",
        "build-prod": "run-p type-check build-only-prod",
        "preview": "vite preview",
        "build-only": "vite build",
        "build-only-staging": "vite build -m staging",
        "build-only-prod": "vite build -m prod",
        "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
        "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
        "format": "prettier --write src/"
    },
    "dependencies": {
        "@ant-design/icons-vue": "^7.0.1",
        "@headlessui/vue": "^1.7.16",
        "@heroicons/vue": "^2.1.1",
        "@popperjs/core": "^2.11.8",
        "@primeuix/themes": "^1.1.1",
        "@tailwindcss/forms": "^0.5.6",
        "@tinymce/tinymce-vue": "^4.0.7",
        "@vuepic/vue-datepicker": "^8.8.1",
        "@vueup/vue-quill": "^1.2.0",
        "ant-design-vue": "^4.2.3",
        "autoprefixer": "^10.4.16",
        "axios": "^1.5.1",
        "emoji-datasource": "^16.0.0",
        "lodash.clonedeep": "^4.5.0",
        "lodash.merge": "^4.6.2",
        "md-editor-v3": "^4.15.6",
        "moment": "^2.29.4",
        "moment-timezone": "^0.5.45",
        "pinia": "^2.1.6",
        "primevue": "^4.3.4",
        "qs": "^6.11.2",
        "tinymce": "^8.1.2",
        "vue": "^3.3.12",
        "vue-i18n": "^9.5.0",
        "vue-moment": "^4.1.0",
        "vue-router": "^4.2.5",
        "vue-select": "^4.0.0-beta.6",
        "vue3-emoji-picker": "^1.1.8",
        "vue3-treeselect": "^0.1.10",
        "vuefinder": "^2.2.0"
    },
    "devDependencies": {
        "@iconify/vue": "^4.1.1",
        "@primevue/auto-import-resolver": "^4.3.4",
        "@rushstack/eslint-patch": "^1.6.1",
        "@tsconfig/node18": "^18.2.0",
        "@types/lodash.clonedeep": "^4.5.7",
        "@types/lodash.merge": "^4.6.7",
        "@types/node": "^20.10.5",
        "@types/qs": "^6.9.8",
        "@types/vue-select": "^3.16.5",
        "@vitejs/plugin-vue": "^5.0.5",
        "@vue/eslint-config-prettier": "^9.0.0",
        "@vue/eslint-config-typescript": "^13.0.0",
        "@vue/tsconfig": "^0.5.1",
        "eslint": "^8.56.0",
        "eslint-plugin-vue": "^9.16.1",
        "laravel-echo": "^1.15.3",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.4.31",
        "prettier": "^3.1.1",
        "pusher-js": "^8.4.0-rc2",
        "sass": "^1.69.2",
        "tailwindcss": "^3.3.7",
        "typescript": "~5.5.3",
        "unplugin-vue-components": "^28.5.0",
        "vite": "^5.0.10",
        "vue-tsc": "^2.0.26"
    }
}
